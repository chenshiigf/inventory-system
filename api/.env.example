# Optional persistent data root; when unset, uses api/data.
INVENTORY_DATA_DIR=
# Optional SQLAlchemy URL; when unset, uses $INVENTORY_DATA_DIR/inventory.db.
DATABASE_URL=

# Visual search: server only. Reuse the existing Nginx htpasswd file (read access).
INVENTORY_HTPASSWD_FILE=
VISUAL_ADMIN_USERS=
VISUAL_ALLOWED_ORIGINS=http://localhost:3002,http://127.0.0.1:3002
DASHSCOPE_API_KEY=
VISUAL_EMBEDDING_MODEL=qwen3-vl-embedding
VISUAL_EMBEDDING_DIMENSION=2560
VISUAL_EMBEDDING_VERSION=v1
VISUAL_EMBEDDING_REGION=cn-beijing
VISUAL_EMBEDDING_ENDPOINT=https://dashscope.aliyuncs.com/api/v1/services/embeddings/multimodal-embedding/multimodal-embedding
VISUAL_EMBEDDING_TIMEOUT=30
VISUAL_EMBEDDING_RETRIES=1
VISUAL_INDEX_INTERVAL=1
VISUAL_MIN_SCORE=0
# Verify current tariffs before any paid evaluation; CNY per 1000 tokens.
VISUAL_IMAGE_PRICE_PER_1K=0.0018
VISUAL_TEXT_PRICE_PER_1K=0.0007
