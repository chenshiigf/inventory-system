#!/usr/bin/env python3
"""Daily SQLite-only deployment backup; uses Python's standard library only."""

from __future__ import annotations

import argparse
import hashlib
import json
import logging
import re
import shutil
import sqlite3
import tempfile
from datetime import datetime, timedelta
from pathlib import Path


logger = logging.getLogger(__name__)
TIMESTAMP = re.compile(r"^\d{4}-\d{2}-\d{2}_\d{6}$")


def sha256(path: Path) -> str:
    digest = hashlib.sha256()
    with path.open("rb") as stream:
        for chunk in iter(lambda: stream.read(1024 * 1024), b""):
            digest.update(chunk)
    return digest.hexdigest()


def prune_backups(destination: Path, now: datetime, retention_days: int) -> None:
    cutoff = (now - timedelta(days=retention_days)).timestamp()
    for directory in destination.iterdir():
        # Delete only completed DB sets directly under this configured root.
        # Full sets, incomplete .tmp directories and symlinks are not ours.
        if not TIMESTAMP.fullmatch(directory.name) or directory.is_symlink() or not directory.is_dir():
            continue
        if directory.resolve().parent != destination:
            continue
        try:
            manifest = json.loads((directory / "manifest.json").read_text(encoding="utf-8"))
            if not isinstance(manifest, dict) or manifest.get("database") != "inventory.db":
                continue
            if manifest.get("integrity_check") != "ok" or not (directory / "inventory.db").is_file():
                continue
            if directory.stat().st_mtime < cutoff:
                shutil.rmtree(directory)
        except (OSError, ValueError):
            logger.warning("DB retention cleanup skipped/failed: %s", directory, exc_info=True)


def backup_database(
    source: Path, destination: Path, *, retention_days: int = 14,
    now: datetime | None = None,
) -> Path:
    source, destination = source.expanduser().resolve(), destination.expanduser().resolve()
    if not source.is_file():
        raise ValueError(f"Source database does not exist: {source}")
    if retention_days < 1:
        raise ValueError("retention_days must be positive")
    # Daily production timestamps use server local time, without a UTC suffix.
    moment = now or datetime.now()
    if moment.tzinfo is not None:
        moment = moment.astimezone().replace(tzinfo=None)
    destination.mkdir(parents=True, exist_ok=True)
    name = moment.strftime("%Y-%m-%d_%H%M%S")
    published = destination / name
    if published.exists():
        raise FileExistsError(f"Backup already exists: {published}")
    staging = Path(tempfile.mkdtemp(prefix=f".{name}-", suffix=".tmp", dir=destination))
    try:
        snapshot = staging / "inventory.db"
        source_db = sqlite3.connect(f"{source.as_uri()}?mode=ro", uri=True, timeout=30)
        try:
            target_db = sqlite3.connect(snapshot)
            try:
                source_db.backup(target_db)
                target_db.commit()
                integrity = target_db.execute("PRAGMA integrity_check").fetchall()
                if integrity != [("ok",)]:
                    raise ValueError(f"Snapshot integrity check failed: {integrity}")
            finally:
                target_db.close()
        finally:
            source_db.close()
        # Match the confirmed production DB-only manifest, not the full format.
        manifest = {
            "created_at": moment.isoformat(timespec="seconds"),
            "source": str(source),
            "database": "inventory.db",
            "size": snapshot.stat().st_size,
            "sha256": sha256(snapshot),
            "integrity_check": "ok",
        }
        (staging / "manifest.json").write_text(
            json.dumps(manifest, ensure_ascii=False, indent=2) + "\n", encoding="utf-8",
        )
        staging.rename(published)
    except Exception:
        try:
            if staging.resolve().parent == destination:
                shutil.rmtree(staging)
        except OSError:
            logger.exception("Failed to remove incomplete backup: %s", staging)
        raise

    # A cleanup failure cannot invalidate the verified published backup or
    # prevent OnSuccess from uploading it.
    try:
        prune_backups(destination, moment, retention_days)
    except OSError:
        logger.warning("DB backup succeeded; retention cleanup failed", exc_info=True)
    return published


def main(argv: list[str] | None = None) -> int:
    parser = argparse.ArgumentParser(description="Create a verified daily SQLite-only backup.")
    parser.add_argument("--source", type=Path, default=Path("/var/lib/inventory-system/inventory.db"))
    parser.add_argument("--destination", type=Path, default=Path("/var/backups/inventory-system/db"))
    parser.add_argument("--retention-days", type=int, default=14)
    args = parser.parse_args(argv)
    logging.basicConfig(level=logging.INFO, format="%(levelname)s: %(message)s")
    try:
        result = backup_database(args.source, args.destination, retention_days=args.retention_days)
    except (OSError, sqlite3.Error, ValueError) as error:
        logger.error("Daily DB backup failed: %s", error)
        return 1
    print(f"Daily DB backup completed: {result} (integrity: ok)")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
