# Safe example paths only; the administrator maintains actual values outside Git.
INVENTORY_DATA_DIR=/var/lib/inventory-system
DATABASE_URL=sqlite:////var/lib/inventory-system/inventory.db
# AI search stays off until an operator creates the private runtime switch.
# Blank daily call count means unlimited; the ¥1 daily budget and per-call reserve remain enforced.
VISUAL_DAILY_MAX_CALLS=
VISUAL_DAILY_BUDGET_CNY=1.00
VISUAL_CALL_RESERVE_CNY=0.003
